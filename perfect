-- 5.3 ใส่ปุ่มในแท็บ Automation
CreateToggle(AutoPage, "Always Perfect Mine", false, function(val)
    AlwaysPerfectEnabled = val
end)

CreateToggle(AutoPage, "Auto Collect Ores", false, function(val)
    AutoCollectEnabled = val
    if AutoCollectEnabled then
        task.spawn(function()
            while AutoCollectEnabled do
                local itemsFolder = GetItemsFolder()
                if itemsFolder then
                    for _, item in pairs(itemsFolder:GetChildren()) do
                        if not AutoCollectEnabled then break end
                        CollectRemote:FireServer(item.Name)
                    end
                end
                task.wait(0.5)
            end
        end)
    end
end)

