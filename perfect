-- 4.6 ตัวสร้างปุ่มและสวิตช์เปิด-ปิด
local elementOrder = 0

local function CreateButton(parent, text, callback)
    elementOrder = elementOrder + 1
    local Btn = Instance.new("TextButton")
    Btn.Size = UDim2.new(0.95, 0, 0, 34)
    Btn.BackgroundColor3 = Color3.fromRGB(45, 45, 60)
    Btn.Text = text
    Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    Btn.Font = Enum.Font.SourceSansMedium
    Btn.TextSize = 14
    Btn.LayoutOrder = elementOrder
    Btn.Parent = parent

    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0, 6)
    Corner.Parent = Btn

    Btn.MouseButton1Click:Connect(callback)
end

local function CreateToggle(parent, text, default, callback)
    elementOrder = elementOrder + 1
    local Toggle = Instance.new("TextButton")
    Toggle.Size = UDim2.new(0.95, 0, 0, 34)
    Toggle.BackgroundColor3 = default and Color3.fromRGB(0, 150, 90) or Color3.fromRGB(45, 45, 60)
    Toggle.Text = text .. (default and " : [ON]" or " : [OFF]")
    Toggle.TextColor3 = Color3.fromRGB(255, 255, 255)
    Toggle.Font = Enum.Font.SourceSansMedium
    Toggle.TextSize = 14
    Toggle.LayoutOrder = elementOrder
    Toggle.Parent = parent

    local state = default
    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0, 6)
    Corner.Parent = Toggle

    Toggle.MouseButton1Click:Connect(function()
        state = not state
        Toggle.BackgroundColor3 = state and Color3.fromRGB(0, 150, 90) or Color3.fromRGB(45, 45, 60)
        Toggle.Text = text .. (state and " : [ON]" or " : [OFF]")
        callback(state)
    end)
end


