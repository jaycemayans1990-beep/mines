-- สร้างหน้าต่างหลัก (Window)
local Window = Ourrodos:CreateWindow({
    Title = "Mining Utility Hub | Solo Development",
    Subtitle = "Configuration Loaded",
    Theme = "Default"
})


-- [[ 2. ฟังก์ชันการทำงานหลัก (Functions) ]]

-- 1. ฟังก์ชันค้นหาโฟลเดอร์เก็บไอเทม
local function GetItemsFolder()
    return workspace:FindFirstChild("Items")
end

-- 2. ฟังก์ชันเทเลพอร์ต (Teleport)
local function tp(pos)
    local root = game.Players.LocalPlayer.Character and game.Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if root then 
        root.CFrame = pos 
    end
end

-- 3. ฟังก์ชันขุดเจาะรูอัตโนมัติ (Execute Original Blast)
local function ExecuteOriginalBlast()
    local Root = game.Players.LocalPlayer.Character and game.Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not Root then return end
    
    local startPos = Root.Position
    local holeWidth = 6
    local holeDepth = 20
    local step = 5     

    for x = -holeWidth, holeWidth, step do
        for z = -holeWidth, holeWidth, step do
            for y = 1, holeDepth, step do
                local targetVector = Vector3.new(
                    startPos.X + x,
                    startPos.Y - y, 
                    startPos.Z + z
                )
                
                task.spawn(function()
                    MiningRemote:FireServer(targetVector, 1)
                end)
            end
        end
        task.wait(0.1) 
    end
end


-- [[ 3. ระบบ Hook เมธอด (Hooks) ]]
local old
old = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
    local method = getnamecallmethod()
    
    if not checkcaller() and self == MiningRemote and method == "FireServer" and AlwaysPerfectEnabled then
        local args = {...}
        if typeof(args[2]) == "number" then
            args[2] = 1 -- Force perfect mining
            return old(self, unpack(args))
        end
    end
    
    return old(self, ...)
end))


-- [[ 4. การสร้างแท็บและเมนู UI (Ourrodos UI Structure) ]]

-- สร้างแท็บ (Tabs)
local MainTab = Window:CreateTab("Automation")
local VisualsTab = Window:CreateTab("Visuals")
local TeleportTab = Window:CreateTab("Teleports")
local MiscTab = Window:CreateTab("Misc")

-- 4.1 แท็บ Automation (Mining)
MainTab:CreateSection("Mining Features")

MainTab:CreateToggle({
    Name = "Always Perfect Mine",
    Default = false,
    Callback = function(Value)
        AlwaysPerfectEnabled = Value
    end
})

MainTab:CreateToggle({
    Name = "Auto Collect Ores (Remote)",
    Default = false,
    Callback = function(Value)
        AutoCollectEnabled = Value
        if AutoCollectEnabled then
            task.spawn(function()
                while AutoCollectEnabled do
                    local itemsFolder = GetItemsFolder()
                    if itemsFolder then
                        for _, item in pairs(itemsFolder:GetChildren()) do
                            if not AutoCollectEnabled then break end
                            CollectRemote:FireServer(item.Name)
                        end
                    end
                    task.wait(0.5)
                end
            end)
        end
    end
})

MainTab:CreateButton({
    Name = "Blast Hole (Original)",
    Callback = function()
        Ourrodos:Notify({Title = "Blasting", Content = "Creating hole beneath you...", Duration = 2})
        ExecuteOriginalBlast()
    end
})

-- 4.2 แท็บ Visuals (ESP)
VisualsTab:CreateSection("ESP")

VisualsTab:CreateToggle({
    Name = "Ores ESP",
    Default = false,
    Callback = function(Value)
        OresESPEnabled = Value
        if OresESPEnabled then
            task.spawn(function()
                while OresESPEnabled do
                    local itemsFolder = GetItemsFolder()
                    if itemsFolder then
                        for _, item in pairs(itemsFolder:GetChildren()) do
                            local targetPart = item:IsA("BasePart") and item or (item:IsA("Model") and item.PrimaryPart)
                            
                            if targetPart and not item:FindFirstChild("OreESP") then
                                local box = Instance.new("BoxHandleAdornment")
                                box.Name = "OreESP"
                                box.Adornee = targetPart
                                box.AlwaysOnTop = true
                                box.Size = item:IsA("Model") and item:GetExtentsSize() or targetPart.Size
                                box.ZIndex = 1
                                box.Transparency = 0.5
                                box.Color3 = targetPart.Color
                                box.Parent = item
                            end
                        end
                    end
                    task.wait(1)
                end
            end)
        else
            local itemsFolder = GetItemsFolder()
            if itemsFolder then
                for _, item in pairs(itemsFolder:GetDescendants()) do
                    if item.Name == "OreESP" then 
                        item:Destroy() 
                    end
                end
            end
        end
    end
})

