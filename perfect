-- [[ 1. ตัวแปรทั้งหมด (Variables) ]]
local AutoCollectEnabled = false
local OresESPEnabled = false
local AlwaysPerfectEnabled = false

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MiningRemote = ReplicatedStorage:WaitForChild("shared/network/MiningNetwork@GlobalMiningEvents"):WaitForChild("Mine")
local CollectRemote = ReplicatedStorage:WaitForChild("shared/network/MiningNetwork@GlobalMiningEvents"):WaitForChild("CollectItem")

