-- [[ SERVICES ]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local VirtualUser = game:GetService("VirtualUser")
local LocalPlayer = Players.LocalPlayer

-- [[ REMOTES ]] -- timeout กันค้างตอนโหลดช้า
local MiningEvents = ReplicatedStorage:WaitForChild("shared/network/MiningNetwork@GlobalMiningEvents", 15)
if not MiningEvents then
   warn("[Mines] MiningNetwork remotes not found — remote names may have changed")
   return
end
local MiningRemote = MiningEvents:WaitForChild("Mine", 15)
local CollectRemote = MiningEvents:WaitForChild("CollectItem", 15)

-- [[ CONFIG ]]
local BLAST = { Width = 6, Depth = 20, Step = 5, Delay = 0.1 }
local COLLECT_SPAWN_DELAY = 0.2 -- รอให้ item init บน server ก่อนขอเก็บ

-- [[ STATE ]]
local State = { Perfect = false, Collect = false, ESP = false }
local AntiAFKConn = nil
local Blasting = false
local itemsFolderCache = nil
local espConns = {}
local collectConns = {}

-- [[ HELPERS ]]
local unpack = table.unpack or unpack

local function GetRoot()
   local char = LocalPlayer.Character
   return char and char:FindFirstChild("HumanoidRootPart")
end

local function GetItemsFolder()
   if itemsFolderCache and itemsFolderCache.Parent then
      return itemsFolderCache
   end
   itemsFolderCache = workspace:FindFirstChild("Items")
   return itemsFolderCache
end

local function SafeFire(remote, ...)
   local ok, err = pcall(remote.FireServer, remote, ...)
   if not ok then warn("[Mines] FireServer failed:", err) end
end

local function Teleport(cf)
   local char = LocalPlayer.Character
   if char then char:PivotTo(cf) end -- PivotTo ย้ายทั้งโมเดล เนียนกว่าแกะ root เดี่ยว
end

-- [[ HOOK — Always Perfect ]] -- guarded: ถ้า executor ไม่รองรับจะไม่พังทั้งไฟล์
local HookReady = false
if hookmetamethod and newcclosure and getnamecallmethod and checkcaller then
   local ok = pcall(function()
      local old
      old = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
         if State.Perfect and not checkcaller() and self == MiningRemote and getnamecallmethod() == "FireServer" then
            local args = { ... }
            if typeof(args[2]) == "number" then
               args[2] = 1
               return old(self, unpack(args))
            end
         end
         return old(self, ...)
      end))
      return ok ~= nil
   end)
   HookReady = ok or false
end
if not HookReady then
   warn("[Mines] hookmetamethod unavailable — Always Perfect disabled")
end

-- [[ BLAST ]] -- ลูปเดียว ไม่ spawn thread ต่อ target, จังหวะยิงเท่าเดิม
local function ExecuteBlast()
   if Blasting then return end
   local root = GetRoot()
   if not root then return end
   Blasting = true

   local pos = root.Position
   for x = -BLAST.Width, BLAST.Width, BLAST.Step do
      for z = -BLAST.Width, BLAST.Width, BLAST.Step do
         for y = 1, BLAST.Depth, BLAST.Step do
            SafeFire(MiningRemote, Vector3.new(pos.X + x, pos.Y - y, pos.Z + z), 1)
            task.wait(BLAST.Delay)
         end
      end
   end
   Blasting = false
end

-- [[ ESP — event-driven ]] -- ไม่มี polling loop, CPU = 0 ตอน idle
local function AttachESP(item)
   if not State.ESP or item:FindFirstChild("OreESP") then return end
   local part
   if item:IsA("BasePart") then
      part = item
   elseif item:IsA("Model") then
      part = item.PrimaryPart or item:FindFirstChildWhichIsA("BasePart") -- เดิม: ไม่มี PrimaryPart = ไม่มีกล่อง
   end
   if not part then return end

   local box = Instance.new("BoxHandleAdornment")
   box.Name = "OreESP"
   box.Adornee = part
   box.AlwaysOnTop = true
   box.Size = item:IsA("Model") and item:GetExtentsSize() or part.Size
   box.ZIndex = 1
   box.Transparency = 0.5
   box.Color3 = part.Color
   box.Parent = item
end

local function ClearESP()
   for _, c in ipairs(espConns) do c:Disconnect() end
   table.clear(espConns)
   local folder = GetItemsFolder()
   if folder then
      for _, d in ipairs(folder:GetDescendants()) do
         if d.Name == "OreESP" then d:Destroy() end
      end
   end
end

local function StartESP()
   local folder = GetItemsFolder()
   if not folder then return end
   for _, item in ipairs(folder:GetChildren()) do
      AttachESP(item)
   end
   table.insert(espConns, folder.ChildAdded:Connect(function(item)
      task.defer(AttachESP, item)
   end))
end

-- [[ AUTO COLLECT — event-driven ]]
local function CollectAll()
   local folder = GetItemsFolder()
   if not folder then return end
   for _, item in ipairs(folder:GetChildren()) do
      SafeFire(CollectRemote, item.Name)
   end
end

local function StartCollect()
   CollectAll() -- เก็บของที่มีอยู่แล้วก่อนรอบเดียว
   local folder = GetItemsFolder()
   if not folder then return end
   table.insert(collectConns, folder.ChildAdded:Connect(function(item)
      if not State.Collect then return end
      task.delay(COLLECT_SPAWN_DELAY, function()
         if State.Collect and item.Parent then
            SafeFire(CollectRemote, item.Name)
         end
      end)
   end))
end

local function StopCollect()
   for _, c in ipairs(collectConns) do c:Disconnect() end
   table.clear(collectConns)
end

