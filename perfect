-- [[ MINING SECTION ]]
MainTab:CreateSection("Mining Features")
MainTab:CreateToggle({
   Name = "Always Perfect Mine",
   CurrentValue = false,
   Flag = "AlwaysPerfect",
   Callback = function(Value)
      AlwaysPerfectEnabled = Value
   end,
})

MainTab:CreateToggle({
   Name = "Auto Collect Ores (Remote)",
   CurrentValue = false,
   Flag = "AutoCollect",
   Callback = function(Value)
      AutoCollectEnabled = Value
      if AutoCollectEnabled then
         task.spawn(function()
            while AutoCollectEnabled do
               local itemsFolder = GetItemsFolder()
               if itemsFolder then
                  for _, item in pairs(itemsFolder:GetChildren()) do
                     if not AutoCollectEnabled then break end
                     CollectRemote:FireServer(item.Name)
                  end
               end
               task.wait(0.5)
            end
         end)
      end
   end,
})

MainTab:CreateButton({
   Name = "Blast Hole (Original)",
   Callback = function()
      Rayfield:Notify({Title = "Blasting", Content = "Creating hole beneath you...", Duration = 2})
      ExecuteOriginalBlast()
   end,
})

-- [[ VISUALS SECTION ]]
VisualsTab:CreateSection("ESP")

VisualsTab:CreateToggle({
   Name = "Ores ESP",
   CurrentValue = false,
   Flag = "OreESP",
   Callback = function(Value)
      OresESPEnabled = Value
      if OresESPEnabled then
         task.spawn(function()
            while OresESPEnabled do
               local itemsFolder = GetItemsFolder()
               if itemsFolder then
                  for _, item in pairs(itemsFolder:GetChildren()) do
                     local targetPart = item:IsA("BasePart") and item or (item:IsA("Model") and item.PrimaryPart)
                     
                     if targetPart and not item:FindFirstChild("OreESP") then
                        local box = Instance.new("BoxHandleAdornment")
                        box.Name = "OreESP"
                        box.Adornee = targetPart
                        box.AlwaysOnTop = true
                        box.Size = item:IsA("Model") and item:GetExtentsSize() or targetPart.Size
                        box.ZIndex = 1
                        box.Transparency = 0.5
                        box.Color3 = targetPart.Color
                        box.Parent = item
                     end
                  end
               end
               task.wait(1)
            end
         end)
      else
         local itemsFolder = GetItemsFolder()
         if itemsFolder then
            for _, item in pairs(itemsFolder:GetDescendants()) do
               if item.Name == "OreESP" then 
                  item:Destroy() 
               end
            end
         end
      end
   end,
})

