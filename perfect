-- [[ VARIABLES ]]
local AutoCollectEnabled = false
local OresESPEnabled = false
local AlwaysPerfectEnabled = false

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MiningRemote = ReplicatedStorage:WaitForChild("shared/network/MiningNetwork@GlobalMiningEvents"):WaitForChild("Mine")
local CollectRemote = ReplicatedStorage:WaitForChild("shared/network/MiningNetwork@GlobalMiningEvents"):WaitForChild("CollectItem")

-- Dynamic Item Folder Resolver
local function GetItemsFolder()
    return workspace:FindFirstChild("Items")
end

-- [[ HOOKS ]]
local old
old = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
    local method = getnamecallmethod()
    
    if not checkcaller() and self == MiningRemote and method == "FireServer" and AlwaysPerfectEnabled then
        local args = {...}
        if typeof(args[2]) == "number" then
            args[2] = 1 -- Force perfect mining
            return old(self, unpack(args))
        end
    end
    
    return old(self, ...)
end))

-- [[ FUNCTIONS ]]
local function ExecuteOriginalBlast()
    local Root = game.Players.LocalPlayer.Character and game.Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not Root then return end
    
    local startPos = Root.Position
    local holeWidth = 6
    local holeDepth = 20
    local step = 5     

    for x = -holeWidth, holeWidth, step do
        for z = -holeWidth, holeWidth, step do
            for y = 1, holeDepth, step do
                local targetVector = Vector3.new(
                    startPos.X + x,
                    startPos.Y - y, 
                    startPos.Z + z
                )
                
                task.spawn(function()
                    MiningRemote:FireServer(targetVector, 1)
                end)
            end
        end
        task.wait(0.1) 
    end
end

local function tp(pos)
    local root = game.Players.LocalPlayer.Character and game.Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if root then 
        root.CFrame = pos 
    end
end

