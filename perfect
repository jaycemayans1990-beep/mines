-- [[ VISUALS SECTION ]]
VisualsTab:CreateSection("ESP")

VisualsTab:CreateToggle({
   Name = "Ores ESP",
   CurrentValue = false,
   Flag = "OreESP",
   Callback = function(Value)
      OresESPEnabled = Value
      if OresESPEnabled then
         task.spawn(function()
            while OresESPEnabled do
               for _, item in pairs(ItemsFolder:GetChildren()) do
                  if not item:FindFirstChild("OreESP") and item:IsA("BasePart") then
                     local box = Instance.new("BoxHandleAdornment", item)
                     box.Name = "OreESP"
                     box.Adornee = item
                     box.AlwaysOnTop = true
                     box.Size = item.Size
                     box.ZIndex = 0
                     box.Transparency = 0.5
                     box.Color3 = item.Color
                  end
               end
               task.wait(1)
            end
         end)
      else
         for _, item in pairs(ItemsFolder:GetDescendants()) do
            if item.Name == "OreESP" then item:Destroy() end
         end
      end
   end,
})

